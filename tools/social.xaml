<!-- The GitHub social preview (1280 x 640) for tools/render-assets.ps1: logo, name, tagline and candles. -->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1280" Height="640">
    <Canvas.Resources>
        <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B0A0A" Offset="0" />
            <GradientStop Color="#4A0F10" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A0A12" Offset="0" />
            <GradientStop Color="#2B0708" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Gold" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F6DC82" Offset="0" />
            <GradientStop Color="#C8961B" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="Glow">
            <GradientStop Color="#F2FFF6CC" Offset="0" />
            <GradientStop Color="#00FFD166" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="Flame" GradientOrigin="0.5,0.7" Center="0.5,0.65" RadiusX="0.5" RadiusY="0.55">
            <GradientStop Color="#FFFFFFE0" Offset="0" />
            <GradientStop Color="#FFFFC83D" Offset="0.45" />
            <GradientStop Color="#00FF8A00" Offset="1" />
        </RadialGradientBrush>
    </Canvas.Resources>

    <Rectangle Width="1280" Height="640" Fill="{StaticResource Bg}" />
    <Rectangle Canvas.Left="28" Canvas.Top="28" Width="1224" Height="584" RadiusX="28" RadiusY="28" Stroke="#D3A625" StrokeThickness="3" />

    <!-- the logo, same shapes as tools/logo.xaml, drawn 1.3 times bigger -->
    <Canvas Canvas.Left="92" Canvas.Top="150" Width="256" Height="256">
        <Canvas.RenderTransform>
            <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
        </Canvas.RenderTransform>
        <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="56" RadiusY="56"
                   Fill="{StaticResource LogoBg}" Stroke="#D3A625" StrokeThickness="6" />
        <Rectangle Canvas.Left="34" Canvas.Top="62" Width="30" Height="150" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />
        <Rectangle Canvas.Left="72" Canvas.Top="137" Width="30" Height="75" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />
        <Rectangle Canvas.Left="110" Canvas.Top="162" Width="30" Height="50" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />
        <Rectangle Canvas.Left="148" Canvas.Top="175" Width="30" Height="37" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />
        <Rectangle Canvas.Left="186" Canvas.Top="182" Width="30" Height="30" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />
        <Path Data="M49,52 C58,112 84,128 125,148 S190,168 216,170" Stroke="#E6FFF3C4" StrokeThickness="4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Ellipse Canvas.Left="23" Canvas.Top="12" Width="52" Height="52" Fill="{StaticResource Glow}" />
        <Path Data="M49,20 L53.5,33.5 L67,38 L53.5,42.5 L49,56 L44.5,42.5 L31,38 L44.5,33.5 Z" Fill="#FFF6CC" />
        <Path Data="M200,61 L202,68 L209,70 L202,72 L200,79 L198,72 L191,70 L198,68 Z" Fill="#FFF6CC" />
        <Path Data="M226,98 L227.5,102.5 L232,104 L227.5,105.5 L226,110 L224.5,105.5 L220,104 L224.5,102.5 Z" Fill="#FFF6CC" />
    </Canvas>

    <!-- name and lines of text -->
    <TextBlock Canvas.Left="470" Canvas.Top="118" Text="Zipfomancy" FontFamily="Gabriola, Georgia" FontSize="150" Foreground="#F2D06B">
        <TextBlock.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="30" Color="#D3A625" Opacity="0.85" />
        </TextBlock.Effect>
    </TextBlock>
    <TextBlock Canvas.Left="482" Canvas.Top="318" Text="Zipf's law, with a little magic." FontFamily="Georgia" FontStyle="Italic" FontSize="40" Foreground="#F6E7C1" />
    <TextBlock Canvas.Left="482" Canvas.Top="388" Text="Harry Potter  ·  Turkish &amp; English  ·  WPF  ·  .NET 10" FontFamily="Georgia" FontSize="24" Foreground="#F6E7C1" Opacity="0.72" />

    <!-- three candles -->
    <Ellipse Canvas.Left="1058" Canvas.Top="350" Width="90" Height="90" Fill="{StaticResource Glow}" Opacity="0.55" />
    <Rectangle Canvas.Left="1092" Canvas.Top="420" Width="22" Height="90" RadiusX="3" RadiusY="3" Fill="#F4EBD0" />
    <Ellipse Canvas.Left="1092" Canvas.Top="372" Width="22" Height="44" Fill="{StaticResource Flame}" />
    <Ellipse Canvas.Left="1118" Canvas.Top="300" Width="100" Height="100" Fill="{StaticResource Glow}" Opacity="0.55" />
    <Rectangle Canvas.Left="1156" Canvas.Top="382" Width="22" Height="128" RadiusX="3" RadiusY="3" Fill="#F4EBD0" />
    <Ellipse Canvas.Left="1156" Canvas.Top="334" Width="22" Height="44" Fill="{StaticResource Flame}" />
    <Ellipse Canvas.Left="1180" Canvas.Top="380" Width="90" Height="90" Fill="{StaticResource Glow}" Opacity="0.55" />
    <Rectangle Canvas.Left="1214" Canvas.Top="448" Width="22" Height="62" RadiusX="3" RadiusY="3" Fill="#F4EBD0" />
    <Ellipse Canvas.Left="1214" Canvas.Top="400" Width="22" Height="44" Fill="{StaticResource Flame}" />
</Canvas>
