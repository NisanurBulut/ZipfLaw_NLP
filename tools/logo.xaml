<!-- The Zipfomancy logo for tools/render-assets.ps1. docs/images/zipfomancy-logo.svg draws the same picture. -->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="256" Height="256">
    <Canvas.Resources>
        <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A0A12" Offset="0" />
            <GradientStop Color="#2B0708" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Gold" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F6DC82" Offset="0" />
            <GradientStop Color="#C8961B" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="Glow">
            <GradientStop Color="#F2FFF6CC" Offset="0" />
            <GradientStop Color="#00FFD166" Offset="1" />
        </RadialGradientBrush>
    </Canvas.Resources>

    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="56" RadiusY="56"
               Fill="{StaticResource Bg}" Stroke="#D3A625" StrokeThickness="6" />

    <Rectangle Canvas.Left="34" Canvas.Top="62" Width="30" Height="150" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />
    <Rectangle Canvas.Left="72" Canvas.Top="137" Width="30" Height="75" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />
    <Rectangle Canvas.Left="110" Canvas.Top="162" Width="30" Height="50" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />
    <Rectangle Canvas.Left="148" Canvas.Top="175" Width="30" Height="37" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />
    <Rectangle Canvas.Left="186" Canvas.Top="182" Width="30" Height="30" RadiusX="5" RadiusY="5" Fill="{StaticResource Gold}" />

    <Path Data="M49,52 C58,112 84,128 125,148 S190,168 216,170" Stroke="#E6FFF3C4" StrokeThickness="4"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

    <Ellipse Canvas.Left="23" Canvas.Top="12" Width="52" Height="52" Fill="{StaticResource Glow}" />
    <Path Data="M49,20 L53.5,33.5 L67,38 L53.5,42.5 L49,56 L44.5,42.5 L31,38 L44.5,33.5 Z" Fill="#FFF6CC" />
    <Path Data="M200,61 L202,68 L209,70 L202,72 L200,79 L198,72 L191,70 L198,68 Z" Fill="#FFF6CC" />
    <Path Data="M226,98 L227.5,102.5 L232,104 L227.5,105.5 L226,110 L224.5,105.5 L220,104 L224.5,102.5 Z" Fill="#FFF6CC" />
</Canvas>
