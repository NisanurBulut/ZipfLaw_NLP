<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Small line icons on a 24 x 24 grid, drawn as plain geometry so they take the colour of the text next to them. -->
    <Geometry x:Key="Icon.Summary">M3,3 H10 V10 H3 Z M14,3 H21 V8 H14 Z M14,12 H21 V21 H14 Z M3,14 H10 V21 H3 Z</Geometry>
    <Geometry x:Key="Icon.Table">M3,4 H21 V20 H3 Z M3,9.5 H21 M3,14.5 H21 M9,4 V20</Geometry>
    <Geometry x:Key="Icon.Chart">M4,3 V20 H21 M7,6 C9,15 13,17 20,17.5</Geometry>
    <Geometry x:Key="Icon.Book">M12,6 C9.5,4 6,4 3,5 V19 C6,18 9.5,18 12,20 C14.5,18 18,18 21,19 V5 C18,4 14.5,4 12,6 Z M12,6 V20</Geometry>
    <Geometry x:Key="Icon.Folder">M3,6 H9 L11,8.5 H21 V19 H3 Z</Geometry>
    <Geometry x:Key="Icon.Globe">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M3,12 H21 M12,3 C8,7.5 8,16.5 12,21 C16,16.5 16,7.5 12,3</Geometry>
    <Geometry x:Key="Icon.Lines">M4,6 H20 M4,12 H20 M4,18 H14</Geometry>
    <Geometry x:Key="Icon.Spark">M12,2 L14.5,9.5 L22,12 L14.5,14.5 L12,22 L9.5,14.5 L2,12 L9.5,9.5 Z</Geometry>
    <Geometry x:Key="Icon.Sigma">M18,5 H6 L12,12 L6,19 H18</Geometry>
    <Geometry x:Key="Icon.Crown">M4,18 L3,7 L8,11 L12,5 L16,11 L21,7 L20,18 Z</Geometry>

    <!-- Use it as a Path: Style="{StaticResource Icon}" Data="{StaticResource Icon.Book}". Set Stroke for another colour. -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
