<Window x:Class="ZipfLaw.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ZipfLaw.Wpf.Controls"
        Title="Zipf Yasası – Büyülü Kelime Sıklığı"
        Width="1120" Height="840" MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        FontFamily="{StaticResource Font.Body}" FontSize="15">

    <Window.Resources>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <!-- Entrance: the title fades in, then the controls and the parchment card float up. -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Header" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:1.2" />
                    <DoubleAnimation Storyboard.TargetName="Controls" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.3" Duration="0:0:0.8" />
                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.5" Duration="0:0:0.9" />
                    <DoubleAnimation Storyboard.TargetName="CardSlide" Storyboard.TargetProperty="Y" From="40" To="0" BeginTime="0:0:0.5" Duration="0:0:0.9">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- The title glows softly, for ever. -->
                    <DoubleAnimation Storyboard.TargetName="HeadingText" Storyboard.TargetProperty="Effect.BlurRadius"
                                     From="8" To="28" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="28,8,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: floating candles on both sides of the title. -->
        <Grid x:Name="Header" Grid.Row="0" Height="140" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="2.6*" />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <controls:Candle Grid.Column="0" Seconds="3.6" Margin="0,18,0,0" VerticalAlignment="Top" />
            <controls:Candle Grid.Column="1" Seconds="4.7" Margin="0,2,0,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" Text="Zipf Yasası" FontSize="64" Style="{StaticResource PageTitle}">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="{DynamicResource Color.Accent}" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="kelimelerin büyülü dağılımı" FontSize="18" FontStyle="Italic" Opacity="0.85"
                           Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
            </StackPanel>
            <controls:Candle Grid.Column="3" Seconds="4.2" Margin="0,6,0,0" VerticalAlignment="Top" />
            <controls:Candle Grid.Column="4" Seconds="5.1" Margin="0,24,0,0" VerticalAlignment="Top" />
        </Grid>

        <!-- Choose a text and a language, then cast the spell. -->
        <Border x:Name="Controls" Grid.Row="1" Style="{StaticResource Parchment}" Padding="14,10" Margin="0,0,0,14" Opacity="0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✦  Büyüyü Başlat" FontSize="17" Command="{Binding AnalyzeCommand}" />
                <!-- Each label stays with its box when the bar wraps on a narrow window. -->
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,3,22,3">
                        <TextBlock Text="Metin" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="290" ItemsSource="{Binding Books}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedBook}" Margin="0,0,6,0" />
                        <Button Content="Başka metin…" Padding="12,5" Click="OnBrowseClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                        <TextBlock Text="Dil" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="105" ItemsSource="{Binding Languages}" DisplayMemberPath="Name"
                                  SelectedValuePath="Language" SelectedValue="{Binding Language}" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- The results on parchment: summary, table and the Zipf plot. -->
        <Border x:Name="Card" Grid.Row="2" Style="{StaticResource Parchment}" Padding="18,12,18,16" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardSlide" />
            </Border.RenderTransform>
            <TabControl Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource Brush.Ink}">
                <TabItem Header="Özet">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,14,18,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="Toplam kelime" Foreground="{DynamicResource Brush.Ink}" Opacity="0.75" FontSize="13" />
                                        <TextBlock Text="{Binding Result.TotalWords, StringFormat=N0}" Foreground="{DynamicResource Brush.Ink}"
                                                   FontFamily="{StaticResource Font.Title}" FontSize="36" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="Benzersiz kelime" Foreground="{DynamicResource Brush.Ink}" Opacity="0.75" FontSize="13" />
                                        <TextBlock Text="{Binding Result.UniqueWords, StringFormat=N0}" Foreground="{DynamicResource Brush.Ink}"
                                                   FontFamily="{StaticResource Font.Title}" FontSize="36" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="A = sıra × olasılık (ilk 100 kelime)" Foreground="{DynamicResource Brush.Ink}" Opacity="0.75" FontSize="13" />
                                        <TextBlock Text="{Binding AverageA, StringFormat=F3}" Foreground="{DynamicResource Brush.Ink}"
                                                   FontFamily="{StaticResource Font.Title}" FontSize="36" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="En sık geçen 15 kelime" Foreground="{DynamicResource Brush.Ink}"
                                       FontFamily="{StaticResource Font.Title}" FontSize="28" Margin="0,16,0,6" />
                            <ItemsControl ItemsSource="{Binding TopWords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource Brush.Ink}" Opacity="0.6"
                                                       HorizontalAlignment="Right" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Word}" Foreground="{DynamicResource Brush.Ink}" FontWeight="SemiBold" />
                                            <!-- The bar grows from the left each time the tab is shown. -->
                                            <Border Grid.Column="2" Height="18" CornerRadius="3" Background="{DynamicResource Brush.Bar}"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Ratio}" />
                                                </Border.RenderTransform>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0" Duration="0:0:1">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Count, StringFormat=N0}" Foreground="{DynamicResource Brush.Ink}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Tablo">
                    <DataGrid ItemsSource="{Binding Result.Words}" Margin="0,14,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="Transparent" RowBackground="Transparent" AlternationCount="2"
                              AlternatingRowBackground="{DynamicResource Brush.PanelAlt}"
                              Foreground="{DynamicResource Brush.Ink}" BorderThickness="0"
                              GridLinesVisibility="None" HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource TableHeader}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sıra" Binding="{Binding Rank}" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Kelime" Binding="{Binding Word}" Width="*" />
                            <DataGridTextColumn Header="Sayı" Binding="{Binding Count, StringFormat=N0}" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Olasılık" Binding="{Binding Probability, StringFormat=F5}" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Sıra × Sayı" Binding="{Binding RankTimesCount, StringFormat=N0}" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Sıra × Olasılık (A)" Binding="{Binding RankTimesProbability, StringFormat=F4}" ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Grafik">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:ZipfPlot Words="{Binding Result.Words}"
                                           LineBrush="{DynamicResource Brush.Line}" IdealBrush="{DynamicResource Brush.Ideal}"
                                           AxisBrush="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ink}" Opacity="0.75" FontSize="13" Margin="8,6,0,0"
                                   Text="Zipf yasası: bir kelimenin sayısı, sırasıyla ters orantılıdır. Logaritmik eksenlerde bu, eğimi −1 olan bir doğru demektir; kelimeler ne kadar yakın uzanırsa yasa o kadar iyi tutar." />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,12,0,0" HorizontalAlignment="Center"
                   FontStyle="Italic" FontSize="14" Foreground="{DynamicResource Brush.Accent}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <!-- While the spell is being cast the line pulses. -->
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.6"
                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
