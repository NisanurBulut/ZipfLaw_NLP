<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/zipfomancy.ico</ApplicationIcon>
    <!-- The built-in Fluent theme (ThemeMode) is still marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZipfLaw.Core\ZipfLaw.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample books stay where they are in the legacy project; they are only linked into the output. -->
    <None Include="..\..\ZipfLawNLP\ReadingFiles\*.txt" Link="Books\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
